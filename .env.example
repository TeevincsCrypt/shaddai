# Copy to .env for local runs, or paste into Vercel → Settings → Environment Variables.
# Nothing is required. With no configuration Shaddai uses public BSC RPC, DexScreener
# and the public Lista API. See "Environment variables" in README.md for where each
# value comes from.

# --- Recommended -------------------------------------------------------------

# Your own BSC mainnet endpoint first, public ones after it as fallback.
# BSC_RPC_URLS=https://<your-provider-endpoint>,https://bsc-rpc.publicnode.com

# Block to start the multiplier-event index from. Leave unset: the index also records
# Ondo sValue updates, which can predate the first bStock. Falls back to SHADDAI_SCAN_FROM_DATE.
# SHADDAI_SCAN_FROM_BLOCK=
SHADDAI_SCAN_FROM_DATE=2026-05-01

# --- Only if you have the value -----------------------------------------------

# Ondo SyntheticSharesOracle on BSC. Unset = the pinned mainnet oracle (or the one the
# deploy-time discovery found). If no oracle answers, Ondo share-equivalents show as not read.
# ONDO_SSO_ADDRESS=

# Extra tokens (e.g. confirmed xStocks), as inline JSON or a path to a JSON file.
# SHADDAI_EXTRA_TOKENS=[{"symbol":"NVDAx","ticker":"NVDA","issuer":"xStocks","address":"0x..."}]

# Extra Lista Lending market ids (bytes32), comma-separated. Usually not needed.
# LISTA_MARKET_IDS=

# Separate endpoints for eth_getLogs, if your main RPC refuses it.
# BSC_LOGS_RPC_URLS=

# --- Buy tab (off unless both are set; server-side only, never in the browser) ---

# Binance Web3 API key and secret: https://web3.binance.com/en/dev-docs/introduction
# BINANCE_WEB3_API_KEY=
# BINANCE_WEB3_API_SECRET=
# SHADDAI_BUY_MAX_USD=25             # largest ticket the server quotes or prepares
# SHADDAI_BUY_MAX_IMPACT_PCT=1       # refuse above this price impact
# SHADDAI_MIN_POOL_LIQUIDITY_USD=25000  # refuse a wrapper whose deepest USDT pool is thinner
# SHADDAI_BUY_SLIPPAGE_PCT=0.5       # slippage sent to /swap
# SHADDAI_QUOTE_WALLET=              # address for quotes before a wallet connects (RFQ quotes want one)
# SHADDAI_USD1_ADDRESS=              # pin USD1; otherwise found by token search and checked on chain

# --- Tuning (leave alone unless something says so) ------------------------------

# SHADDAI_LOG_CHUNK=50000            # starting eth_getLogs window; halves on range errors
# SHADDAI_MAX_REPLAY_LOGS=20000      # cap on Transfer logs replayed per token
# SHADDAI_SNAPSHOT_BUDGET_MS=240000  # time the deploy-time index snapshot may take
# SHADDAI_MODE=live                  # "demo" serves every address from the fixture chain

# --- Local only (Vercel sets these itself) --------------------------------------

# PORT=8787
# SHADDAI_CACHE_DIR=.cache           # /tmp/shaddai-cache on Vercel
# SHADDAI_SEED_DIR=dist/index-cache
