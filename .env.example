# Copy to .env (never commit it). Everything is optional: with no config Shaddai
# uses public BSC RPC endpoints and DexScreener.

# Port for the API + static web server.
PORT=8787

# "live" (default) or "demo". In demo mode every address is read from the
# in-process fixture chain, so nothing touches the network.
SHADDAI_MODE=live

# Comma-separated BSC JSON-RPC endpoints, tried in order with failover.
# An archive endpoint makes the ledger's raw_at_event exact without log replay.
# BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.bnbchain.org

# Separate endpoints for eth_getLogs (some public nodes disable it).
# BSC_LOGS_RPC_URLS=https://bsc-rpc.publicnode.com

# Where the multiplier-event scan starts. Block wins over date.
# SHADDAI_SCAN_FROM_BLOCK=
SHADDAI_SCAN_FROM_DATE=2026-05-01

# Initial eth_getLogs window; halves on "range too large" style errors.
SHADDAI_LOG_CHUNK=50000

# Optional Etherscan V2 key (chainid=56). When set, multiplier events are read
# through the explorer API instead of chunked eth_getLogs.
# ETHERSCAN_API_KEY=

# Ondo SyntheticSharesOracle on BSC. Unset = sValue column shows "not configured".
# ONDO_SSO_ADDRESS=

# Extra Lista Lending (Moolah) market ids to check, comma-separated bytes32.
# LISTA_MARKET_IDS=

# JSON file with extra registry tokens (e.g. confirmed xStocks addresses).
# SHADDAI_EXTRA_TOKENS=./registry.local.json
