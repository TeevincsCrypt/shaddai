{
  "name": "shaddai",
  "version": "0.1.0",
  "private": true,
  "description": "Share-true accounting for tokenized stocks on BSC: raw balances, multipliers, corporate-action ledger, collateral warnings.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "local": "tsx --env-file=.env src/server/main.ts",
    "demo": "tsx src/server/main.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx scripts/probe.ts",
    "check": "npm run typecheck && prettier --check . && npm test",
    "format": "prettier --write .",
    "index:snapshot": "tsx scripts/build-index.ts",
    "discover:ondo": "tsx scripts/discover-ondo.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "demo:deck": "tsx demo/render-deck.ts",
    "demo:walkthrough": "tsx demo/record-walkthrough.ts",
    "verify:evm": "npm --prefix verify/evm install --no-audit --no-fund && tsx verify/evm/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@vercel/functions": "^3.9.9",
    "hono": "^4.10.0",
    "tsx": "^4.20.0",
    "viem": "^2.40.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@binance-web3/wallet": "^12.3.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
