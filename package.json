{
  "name": "shaddai",
  "version": "0.1.0",
  "private": true,
  "description": "Share-true accounting for tokenized stocks on BSC: raw balances, multipliers, corporate-action ledger, collateral warnings.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "demo": "SHADDAI_MODE=demo npm start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx scripts/probe.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "tsx": "^4.20.0",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
